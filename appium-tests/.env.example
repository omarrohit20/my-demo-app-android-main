# Copy this file to .env (in this appium-tests/ folder) and fill in real
# values. @wdio/cli loads .env automatically on every `npm run test:*` /
# `npx wdio run ...` invocation (via its own "dotenv/config" import) — no
# extra setup needed, just create the file.
#
# .env is gitignored — never commit real credentials.

# --- BrowserStack App Automate (wdio.browserstack.conf.js) ---
# Required to run `npm run test:browserstack`. Get these from
# https://www.browserstack.com/accounts/settings
#
# This config always runs the accessibility scan (same as
# wdio.a11y.conf.js's local run — it sets A11Y_SCAN itself, nothing to
# configure) against this repo's own release/mda.apk — there is no env var
# to point it at a different app or run a plain functional-only pass.
BROWSERSTACK_USERNAME=
BROWSERSTACK_ACCESS_KEY=

# Optional — device to run on. Defaults shown below (see README.md,
# "Running on BrowserStack").
BROWSERSTACK_DEVICE_NAME=Google Pixel 7
BROWSERSTACK_DEVICE_VERSION=13.0

# --- Axe DevTools for Mobile (utils/toolAvailability.js) ---
# Only used to report whether a key is configured — this app has no Axe
# DevTools Mobile SDK linked in, so setting this does NOT make that scan run
# (see README.md, "Accessibility tool coverage").
AXE_DEVTOOLS_API_KEY=
